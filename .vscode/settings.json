{
    // "editor.formatOnSave": false,
    // "workbench.preferredHighContrastColorTheme": "Cobalt2",
    // "workbench.preferredHighContrastColorTheme": "Ayu Dark",
    "workbench.preferredHighContrastColorTheme": "Monokai Dark Ninja",
    // "workbench.preferredHighContrastColorTheme": "Dracula Pro",
    // "liveServer.settings.CustomBrowser": "firefox",
    "window.zoomLevel": 3,
    "window.zoomPerWindow": true,
    "editor.cursorBlinking": "solid",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        // "phaser": true,
        ".mytmp": true,
        "dummy-phaser": true,
        "font-container-9slice": true,
        "gameloop": true,
        "hit-area": true,
        "loading-assets": true,
        "using-phaser": true,
        "button-and-checkbox": true,
        "event-emitter": true,
        "container-tutorial-script.md": true
    },
    "javascript.validate.enable": false,
    "prettier.tabWidth": 4,
    "prettier.singleQuote": false,
    "prettier.trailingComma": "all"
}
